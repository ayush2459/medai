# --- Database ---
DATABASE_URL=postgresql+psycopg2://medintel:medintel@localhost:5432/medintel

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
SECRET_KEY=change-this-to-a-random-64-char-string
